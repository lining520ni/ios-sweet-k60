+			_doprnt(debugger_panic_str, debugger_panic_args, consdebug_putc, 0);
+#pragma clang diagnostic pop
+		}
+		panic_debugger_log("\nK60PANIC: ========================\n");
+	}
 	panic_spin_forever();
 }
 
